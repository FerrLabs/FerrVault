#!/usr/bin/env bash
set -euo pipefail

if [ ! -f go.mod ]; then
  echo "no go.mod — skipping pre-push checks"
  exit 0
fi

echo "==> gofmt -l ."
DIFF=$(gofmt -l .)
if [ -n "$DIFF" ]; then
  echo "Files need gofmt:"
  echo "$DIFF"
  exit 1
fi

echo "==> go vet ./..."
go vet ./...

if command -v golangci-lint >/dev/null 2>&1; then
  echo "==> golangci-lint run"
  golangci-lint run
else
  echo "(golangci-lint not installed — skipping; CI will run it)"
fi

echo "==> go test ./..."
if [ "${CGO_ENABLED:-1}" = "0" ] || ! command -v cc >/dev/null 2>&1 && ! command -v gcc >/dev/null 2>&1; then
  go test ./...
else
  go test -race ./...
fi

echo "==> go build ./cmd/..."
go build -o /dev/null ./cmd/...
